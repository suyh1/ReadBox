{
  "name": "readbox",
  "productName": "ReadBox",
  "version": "0.1.7",
  "description": "离线 EPUB 阅读器",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "notes": "python3 scripts/release.py notes"
  },
  "dependencies": {
    "@lucide/vue": "1.79.0",
    "epubjs": "0.3.93",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue-tsc": "3.3.14"
  }
}
